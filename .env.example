# ==============================================================================
# EdTech CRM & Inquiry System - Root Environment Variables Template (.env.example)
# Copy these values into your backend/.env and frontend/.env respectively.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Database Connection String:
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Or Direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Detected Supabase Project: cvchakitmwgsuqhttiaz
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.cvchakitmwgsuqhttiaz.supabase.co:5432/postgres

# Custom JWT Authentication Configuration (Supabase Auth bypassed as required)
JWT_SECRET=super_secret_jwt_edtech_crm_key_assessment_2026_replace_in_prod
JWT_EXPIRES_IN=24h

# Allowed Client Origin (Frontend)
CLIENT_URL=http://localhost:5173

# Default Admin Credentials for Seeding (npm run seed)
ADMIN_DEFAULT_EMAIL=admin@edtech.com
ADMIN_DEFAULT_PASSWORD=AdminPassword@123

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (frontend/.env)
# ------------------------------------------------------------------------------
# In local development with Vite proxy, '/api' forwards directly to http://localhost:5000/api
# In production, set to your deployed backend URL: https://your-backend.onrender.com/api
VITE_API_BASE_URL=/api
